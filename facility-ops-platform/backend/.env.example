# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/facilityops

# Agent tuning — Energy
ENERGY_ANOMALY_STD_THRESHOLD=2.0
ENERGY_BASELINE_WINDOW_DAYS=14
ENERGY_FORECAST_HORIZON_HOURS=24

# Agent tuning — Maintenance
MAINT_HEALTH_WARNING_THRESHOLD=75
MAINT_HEALTH_CRITICAL_THRESHOLD=50
MAINT_FAILURE_RISK_THRESHOLD=65
MAINT_BASE_DECAY_RATE=0.6
MAINT_WORK_ORDER_LEAD_DAYS=3
MAINT_WORK_ORDER_WINDOW_DAYS=21

# Agent tuning — Occupancy
OCC_OVERCROWDING_THRESHOLD_PCT=90
OCC_IDEAL_UTILIZATION_PCT=75
OCC_UNDERUTILIZED_THRESHOLD_PCT=30
OCC_BASELINE_WINDOW_DAYS=14

# CORS
CLIENT_ORIGIN=http://localhost:5173
